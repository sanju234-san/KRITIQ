# ---- Kritiq Backend Environment Variables --------------------------------
# Copy this file to `.env` and fill in real values before running the backend.
# `.env` is listed in .gitignore — never commit real secrets to Git.

# Server Settings
PORT=8000
HOST=0.0.0.0

# --- Database ---
# MongoDB connection URI used by app/db/mongo_client.py.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# MongoDB database name that holds users, reviews, translations, explanations,
# history, and connected repositories collections.
DATABASE_NAME=kritiq

# --- AI Providers ---
# Google Gemini API key used by ai_agent/ for code review, explanation and
# translation prompts.  Get one from https://aistudio.google.com/
# Leave blank only when running tests (they mock the AI calls).
GEMINI_API_KEY=your-gemini-api-key

# Groq API key — FALLBACK provider when Gemini is unavailable or times out.
# Also used standalone when GEMINI_API_KEY is not configured.
# Get one from https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# Optional: shared GitHub Personal Access Token.
#
# IMPORTANT: prefer per-user GitHub OAuth tokens issued through the
# /auth/github flow.  The shared GITHUB_TOKEN below is used as a FALLBACK
# only when the caller is either unauthenticated or has not linked a GitHub
# account via OAuth.  It must NEVER be used to serve private repository
# content to a user because it grants the same identity to every caller.
# Leave blank in development to force the code paths through per-user tokens.
GITHUB_TOKEN=your-github-personal-access-token

# --- Kritiq JWT Session ---
# Long, high-entropy random value used to sign user JWTs.
# In production replace the default `mock-secret` with a strong random string
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
JWT_SECRET=your-jwt-secret-key

# Signing algorithm for JWTs.  HS256 is the supported symmetric algorithm.
JWT_ALGORITHM=HS256

# Number of minutes before a Kritiq JWT expires.
TOKEN_EXPIRE_MINUTES=120

# Public base URL of the Kritiq FRONTEND (Vite dev server or production CDN).
# Used for:
#   - OAuth callback success/error redirects (frontend handoff)
#   - Any emails or generated links that point back into the browser UI.
FRONTEND_URL=http://localhost:5173

# --- GitHub OAuth Application ------------------------------------------------
# Register one at https://github.com/settings/developers  →  "New OAuth App".
# Homepage URL:  http://localhost:5173   (or your production frontend)
# Authorization callback URL:  http://localhost:8000/auth/github/callback
#                                 (matches GITHUB_REDIRECT_URI below — NO /api prefix)

# Client ID is public and can safely appear in backend environment variables.
GITHUB_CLIENT_ID=your-github-oauth-client-id

# Client SECRET is sensitive.  NEVER hardcode, NEVER commit, NEVER log,
# NEVER expose to the frontend, NEVER print in diagnostics or error messages.
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# EXACTLY matches the "Authorization callback URL" configured on the GitHub
# OAuth App settings page, including scheme, host, port (if any) and path.
# Mismatch = GitHub returns `redirect_uri_mismatch` on the callback.
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Space-separated OAuth scopes requested from GitHub during login.
#   read:user   →  fetch the authenticated user's GitHub id/name/avatar.
#   user:email  →  fetch the user's primary (verified) email via /user/emails
#                  since /user only yields it when explicitly public.
#   repo        →  allow Kritiq to browse/clone the user's private
#                  repositories for AI code review.  THIS IS THE MINIMUM
#                  scope that enables private-repo access; requesting
#                  anything narrower (public_repo) would break private-repo
#                  support for the authenticated user.
GITHUB_OAUTH_SCOPES=read:user user:email repo
